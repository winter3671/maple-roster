{
  "name": "maple-roster",
  "version": "0.1.0",
  "private": true,
  "description": "메이플스토리 캐릭터별 보스·사냥 수익 기록장",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc -b --pretty",
    "build": "npm run typecheck && electron-vite build",
    "format": "prettier --write src electron.vite.config.ts tsconfig*.json package.json .prettierrc.json README.md",
    "format:check": "prettier --check src electron.vite.config.ts tsconfig*.json package.json .prettierrc.json README.md"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.6.0",
    "electron-vite": "^5.0.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.7"
  }
}
